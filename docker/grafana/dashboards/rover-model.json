     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "postgres"
     },
     "rawSql": "SELECT camera_id, count(*) AS judgements, count(*) FILTER (WHERE alert) AS alerts, round(avg(probability)::numeric, 3) AS mean_probability, max(model_version) AS model FROM predictions WHERE event_time > now() - interval '1 hour' GROUP BY 1 ORDER BY 2 DESC",
