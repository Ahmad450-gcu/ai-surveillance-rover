    "uid": "postgres"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "postgres"
     },
     "rawSql": "SELECT count(*) AS alerts, count(*) FILTER (WHERE label = 'real') AS real, count(*) FILTER (WHERE label = 'false_alarm') AS false_alarm, count(*) FILTER (WHERE label IS NULL) AS not_reviewed FROM alerts WHERE type = 'loitering' AND received > now() - interval '7 days'",
