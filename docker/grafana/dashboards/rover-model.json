{
 "uid": "rover-model",
 "title": "Rover \u00b7 Model & drift",
 "description": "Data drift vs the training data, prediction drift, concept drift, retraining requests.",
 "tags": [
  "rover"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "camera",
    "label": "Camera",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(rover_drift_psi, camera)",
     "refId": "cam"
    },
    "definition": "label_values(rover_drift_psi, camera)",
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
