# Copy to terraform.tfvars (git-ignored) and fill in.
region        = "eu-central-1"
instance_type = "t3.large"
key_name      = "rover-key"            # EC2 -> Key pairs -> Create (keep the .pem: it becomes the secret EC2_SSH_KEY)
ssh_cidrs     = ["203.0.113.7/32"]     # your public IP; see docs/DEPLOYMENT.md for GitHub Actions access
app_cidrs     = ["203.0.113.7/32"]
open_ports    = [8080, 3000]
