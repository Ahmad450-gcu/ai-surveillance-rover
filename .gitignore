# environment
.venv/
venv/
.env
.ruff_cache/
.pytest_cache/
__pycache__/
*.pyc
.DS_Store

# downloaded / generated (not redistributed)
data/*
!data/manifests/
models/*.pt
# trained models live in the MLflow registry (deploy: python -m mlops.registry pull), not in git
models/fight_model.*
mlruns/
.dvc/cache/
tests/videos/*
!tests/videos/.gitkeep
alerts/
outputs/
zones.json
*.mp4

# personal documents
*.pdf
*.docx
instructions.txt
backend/surveillance.db
backend/.jwt_secret
docs/report_src/media/
documents/

# report sources (report text, university template, figures): not part of the code
docs/report_src/

# deployment state on a deployed machine (deploy/deploy.sh)
.deploy/
# Terraform (deploy/aws): provider cache, state (holds resource details) and your variables
deploy/aws/.terraform/
deploy/aws/.terraform.lock.hcl
*.tfstate
*.tfstate.*
deploy/aws/terraform.tfvars
# the AWS server's passwords (tools/aws.py prepare)
deploy/aws/server.env

# personal list of addresses and logins (never committed)
MY_LOGINS.txt
