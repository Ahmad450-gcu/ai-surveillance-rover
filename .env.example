# Copy to .env and fill in real values:   copy .env.example .env   (Windows)   cp .env.example .env   (Linux/Mac)
# .env is git-ignored; never commit secrets. Generate random values with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Moving to a cloud VM (e.g. AWS EC2) only means changing the values in this file.

# ---------------- Docker stack (docker-compose.yml) ----------------
POSTGRES_USER=rover
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rover
MINIO_ROOT_USER=rover-admin
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
# Image names used when building/pushing (e.g. ghcr.io/<github-user>/ai-surveillance-rover)
IMAGE_PREFIX=rover
IMAGE_TAG=latest

# ---------------- model serving (docker compose service "serving", port 8000) ----------------
# SERVING_MODELS=fight=fight-detector     # activity=registered model; add more activities comma-separated
# MODEL_SOURCE=registry                   # or local: serve ./models/<activity>_model.onnx without MLflow
# RELOAD_SECONDS=60                       # how often serving looks for a new @champion
# Protects POST /admin/reload (empty = open, fine on a laptop; set it on a cloud VM)
SERVING_ADMIN_TOKEN=change-me

# ---------------- application secrets ----------------
# Any config.yaml value can be overridden as ROVER__<SECTION>__<KEY>.
# Shared secret between the detector and the backend (/api/device/*)
ROVER__BACKEND__DEVICE_TOKEN=change-me
# Signs the dashboard/app login tokens
ROVER__BACKEND__JWT_SECRET=change-me
# Shared secret between the laptop and the Pi agent (rover_agent.py --token)
ROVER__ROVER__TOKEN=change-me

# ---------------- where the services are (from the laptop running the detector / training) ----------------
MLFLOW_TRACKING_URI=http://localhost:5000
# ROVER__BACKEND__URL=http://localhost:8080
# ROVER__ROVER__URL=http://192.168.137.50:8000
# Run the backend outside Docker against the Docker PostgreSQL (default without this: local SQLite file)
# DATABASE_URL=postgresql+psycopg://rover:<POSTGRES_PASSWORD>@localhost:5432/rover
